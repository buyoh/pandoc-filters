{
  "name": "pandoc-filters",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "tsc -p ./tsconfig.json && pnpm --filter app-server build",
    "lint": "prettier --write '{src,tests,app-server/src,pandoc-runner/src}/**/*.ts'",
    "lint:check": "prettier --check '{src,tests,app-server/src,pandoc-runner/src}/**/*.ts'",
    "test": "pnpm run build && node --test dist/tests/filter.test.js",
    "app-server:build": "pnpm --filter app-server build",
    "app-server:start": "pnpm --filter app-server start",
    "app-server:dev": "pnpm --filter app-server dev",
    "app-server:dev:watch": "pnpm --filter app-server dev:watch",
    "app-server:test": "pnpm --filter app-server test",
    "app-server:test:watch": "pnpm --filter app-server test:watch",
    "pandoc-runner:build": "pnpm --filter pandoc-runner build",
    "pandoc-runner:test": "pnpm --filter pandoc-runner test",
    "pandoc-runner:typecheck": "pnpm --filter pandoc-runner typecheck",
    "pandoc-runner:start": "cd pandoc-runner && node dist/index.js"
  },
  "dependencies": {
    "pandoc-filter": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prettier": "^3.3.1",
    "typescript": "^5.4.5"
  }
}
