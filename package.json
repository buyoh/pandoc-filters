{
  "name": "pandoc-filters",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "src/app-server",
    "pandoc-runner"
  ],
  "scripts": {
    "build": "tsc -p ./tsconfig.json && yarn workspace app-server build",
    "lint": "prettier --write 'src/**/*.ts'",
    "test": "npm run build && node --test dist/tests/filter.test.js",
    "app-server:build": "yarn workspace app-server build",
    "app-server:start": "yarn workspace app-server start",
    "app-server:dev": "yarn workspace app-server dev",
    "app-server:dev:watch": "yarn workspace app-server dev:watch",
    "app-server:test": "yarn workspace app-server test",
    "pandoc-runner:test": "cd pandoc-runner && bundle exec rake test",
    "pandoc-runner:start": "cd pandoc-runner && ruby pandoc-runner.rb"
  },
  "dependencies": {
    "pandoc-filter": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.8.1",
    "prettier": "^3.3.1",
    "typescript": "^5.4.5"
  }
}
