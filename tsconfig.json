{
  "compilerOptions": {
    "outDir": "dist",
    "target": "ES2019",
    "lib": [
      "esnext"
    ],
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false,
    "esModuleInterop": true,
    "module": "CommonJS",
    "moduleResolution": "node",
    // "resolveJsonModule": true,
    // "isolatedModules": true,
    // "incremental": true,
    "removeComments": true,
    "plugins": []
  },
  "exclude": [
    "node_modules"
  ],
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts"
  ]
}