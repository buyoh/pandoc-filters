{
  "name": "app-server",
  "version": "1.0.0",
  "description": "Express TypeScript web server for pandoc conversion API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:args": "node dist/index.js --",
    "dev": "tsx src/index.ts",
    "dev:args": "tsx src/index.ts --",
    "dev:watch": "tsx watch src/index.ts",
    "test": "tsx --test src/tests/**/*.test.ts",
    "test:watch": "tsx --test --watch src/tests/**/*.test.ts"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0"
  }
}
